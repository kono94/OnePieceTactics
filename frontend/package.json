{
    "name": "tft-frontend",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit -p tsconfig.build.json && vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "type-check": "vue-tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@stomp/stompjs": "^7.3.0",
        "vue": "^3.5.39"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^6.0.7",
        "@vue/eslint-config-prettier": "^10.2.0",
        "@vue/eslint-config-typescript": "^14.9.0",
        "@vue/test-utils": "^2.4.11",
        "eslint": "^9.39.4",
        "eslint-plugin-vue": "^10.9.2",
        "jiti": "^2.7.0",
        "jsdom": "^29.1.1",
        "typescript": "^5.9.3",
        "vite": "^8.1.3",
        "vitest": "^4.1.10",
        "vue-tsc": "^3.3.6"
    }
}
